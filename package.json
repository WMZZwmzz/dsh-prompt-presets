{
  "name": "@local/prompt-presets",
  "version": "1.4.0",
  "private": true,
  "description": "Per-session system-prompt preset chip beside the composer permission control, with a Settings page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WMZZwmzz/dsh-prompt-presets.git"
  },
  "homepage": "https://github.com/WMZZwmzz/dsh-prompt-presets#readme",
  "bugs": {
    "url": "https://github.com/WMZZwmzz/dsh-prompt-presets/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "system-prompt"
  ],
  "type": "module",
  "scripts": {
    "test": "node test/model.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
